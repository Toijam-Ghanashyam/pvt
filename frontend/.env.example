# GeoSync Frontend Environment Configuration
# Copy this file to .env and adjust values for your local setup

# Backend API Endpoint (when connecting to Flask / FastAPI / PostGIS backend)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Optional: Mapbox / Tile Server tokens (if custom satellite basemaps require an API key)
# VITE_MAPBOX_TOKEN=your_mapbox_token_here
